# ==============================================================================
# B2B HoReCa HACCP SaaS Backend - Environment Configuration
# Target: NestJS + PostgreSQL (GCP Cloud SQL / Cloud Run ready)
# ==============================================================================

# Application Setup
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=apple
DB_PASSWORD=
DB_NAME=haccp_db

# TypeORM Settings
# WARNING: DB_SYNCHRONIZE should ONLY be set to 'true' in local development!
# In production (GCP Cloud Run / Cloud SQL), use TypeORM migrations.
DB_SYNCHRONIZE=true
DB_LOGGING=true

# GCP Cloud SQL Connection (Used when deployed to Cloud Run)
# INSTANCE_CONNECTION_NAME=project-id:region:instance-name

# Security & JWT Tokens
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=86400s
